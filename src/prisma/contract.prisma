// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  createdAt DateTime @default(now())
  saves     Int[]    @default([])
}

model Save {
  id      Int    @id @default(autoincrement())
  host    Int
  members Int[]  @default([])
  name    String
}
